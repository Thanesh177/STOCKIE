# Use `remote` on Render/App Runner and provide the URL of a service that exposes POST /predict.
# Use `local` only on a computer that has prediction.py, stoc.h5, and TensorFlow installed.
PREDICTION_MODE=remote
PREDICTION_API_URL=https://your-prediction-service.example.com/predict
TWELVE_DATA_API_KEY=your_twelve_data_api_key
FINNHUB_API_KEY=your_finnhub_api_key
QUOTE_CACHE_SECONDS=60
PREDICTION_TIMEOUT_SECONDS=15
PORT=8080
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=45
LOG_LEVEL=INFO
